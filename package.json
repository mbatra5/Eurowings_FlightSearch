{
  "name": "eurowings",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "EurowingsTest": "cypress run --browser chrome --headed --spec \"cypress/e2e/desktop/functional/**.feature\" --reporter mochawesome",
    "vca": "cypress run --browser chrome --spec \"cypress/e2e/desktop/functional/VCA_Login.feature\" --reporter mochawesome",
    "test": "cypress run --spec \"cypress/e2e/accessibility/**/*.feature\"",
    "merge-reports": "mochawesome-merge cypress/reports/*.json > cypress/reports/report.json",
    "generate-report": "marge cypress/reports/report.json -f report -o cypress/reports",
    "test:report": "npm run test && npm run merge-reports && npm run generate-report"
  },
  "keywords": [
    "cypress"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@percy/cli": "^1.27.4",
    "@percy/cypress": "^3.1.2",
    "@types/cypress-cucumber-preprocessor": "^4.0.1",
    "axe-core": "^3.5.6",
    "cy-verify-downloads": "^0.1.5",
    "cypress": "^13.5.1",
    "cypress-axe": "^1.5.0",
    "cypress-cucumber-preprocessor": "^4.3.1",
    "cypress-iframe": "^1.0.1",
    "cypress-mochawesome-reporter": "^3.4.0",
    "cypress-xpath": "^2.0.1",
    "mocha": "^10.2.0",
    "mochawesome": "^7.1.3",
    "typescript": "^5.0.3"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": true,
    "step_definitions": "cypress/e2e/desktop/functional"
  },
  "dependencies": {
    "cypress-real-events": "^1.7.6",
    "prettier": "^2.8.8",
    "cypress-commands": "^1.1.0"
  }
}
